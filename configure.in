AC_INIT(httpfs, 0.1)
AC_CONFIG_SRCDIR(Makefile.am)
AM_INIT_AUTOMAKE

AC_PROG_CC

PKG_CHECK_MODULES(HTTPFS, libxml-2.0)

HTTPFS_SHARED_LIBS="-lxml2 -lpthread -lnetfs -lfshelp -lports -liohelp -lshouldbeinlibc -lhurdbugaddr"
AC_SUBST([HTTPFS_SHARED_LIBS])

# Optional test suite integration (auto-enabled if dependencies are found)
AC_ARG_ENABLE([test],
    AS_HELP_STRING([--enable-test], [Enable test compilation (cmocka and libmicrohttpd) [default=auto]]),
    [enable_test=$enableval],
    [enable_test=auto])

have_test=no
AS_IF([test "x$enable_test" != "xno"], [
    PKG_CHECK_MODULES([MHD], [libmicrohttpd >= 0.9.0], [
        PKG_CHECK_MODULES([CMOCKA], [cmocka >= 1.1.0], [
            have_test=yes
        ], [
            AS_IF([test "x$enable_test" = "xyes"], [
                AC_MSG_ERROR([cmocka not found, but --enable-test was requested.])
            ])
        ])
    ], [
        AS_IF([test "x$enable_test" = "xyes"], [
            AC_MSG_ERROR([libmicrohttpd not found, but --enable-test was requested.])
        ])
    ])
])

AM_CONDITIONAL([ENABLE_TESTS], [test "x$have_test" = "xyes"])

CFLAGS="$CFLAGS -D_FILE_OFFSET_BITS=64 $HTTPFS_CFLAGS"
LIBS="$LIBS $HTTPFS_LIBS"

AC_SUBST(LIBS)
AC_SUBST([CMOCKA_CFLAGS])
AC_SUBST([CMOCKA_LIBS])

AM_CONFIG_HEADER(config.h)

AC_OUTPUT(
    Makefile
    tests/Makefile
)
